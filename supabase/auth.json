{
  "site_url": "https://stevenpisani.com",
  "uri_allow_list": "https://stevenpisani.com/**,http://localhost:4000/**,http://127.0.0.1:4000/**",
  "disable_signup": true,
  "oauth_server_enabled": true,
  "oauth_server_authorization_path": "/apps/authorize",
  "oauth_server_allow_dynamic_registration": true,
  "mailer_subjects_magic_link": "Sign in to stevenpisani.com",
  "mailer_otp_length": 6,
  "jwt_exp": 3600,
  "refresh_token_rotation_enabled": true,
  "security_refresh_token_reuse_interval": 10,
  "sessions_timebox": null,
  "sessions_inactivity_timeout": null
}
