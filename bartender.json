---
# What the AI bartender knows, built from the site's own data so there's one source: the
# Supabase function (supabase/functions/bartender) reads this and puts it in its prompt.
layout: null
---
{%- assign p = site.data.profile -%}
{%- include books-read.html -%}
{
  "site": {{ site.url | jsonify }},
  "steve": {
    "headline": {{ p.headline | jsonify }},
    "business": {{ p.business | strip | jsonify }},
    "what": {{ p.what | strip | jsonify }},
    "focus": {{ p.focus | jsonify }},
    "skills": {{ p.skills | jsonify }},
    "email": {{ site.email | jsonify }},
    "links": {{ site.links | jsonify }},
    "likes": {{ site.data.bar.likes | jsonify }},
    "career": [{% for t in site.data.timeline %}{{ t.role | append: ", " | append: t.org | append: " (" | append: t.dates | append: ")" | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}]
  },
  "menu": [{% for m in site.data.bar.menu %}{{ m.label | append: ": " | append: m.note | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
  "drinks": [{% for d in site.data.drinks %}
    { "name": {{ d.name | jsonify }}, "origin": {{ d.origin | jsonify }}, "glass": {{ d.glass | jsonify }}, "build": {{ d.build | jsonify }}, "method": {{ d.method | jsonify }}, "note": {{ d.note | jsonify }} }{% unless forloop.last %},{% endunless %}{% endfor %}
  ],
  "writing": [{% for post in site.posts %}{{ post.title | append: " (" | append: post.url | append: ")" | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
  "lab": [{% for item in site.data.lab %}{{ item.title | append: ": " | append: item.blurb | strip | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
  "listening": [{% for b in site.data.audible.listening %}{% include read-too.html b=b %}{% capture f %}{{ b.title }} by {{ b.authors[0] }}{% if read_too %} (read it on paper before){% endif %}{% endcapture %}{{ f | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
  "finished": [{% for b in site.data.audible.finished limit: 40 %}{% include read-too.html b=b %}{% capture f %}{{ b.title }} by {{ b.authors[0] }}{% if b.finished_on %} (finished {{ b.finished_on | date: "%B %Y" }}){% endif %}{% if read_too %} (read it on paper too){% endif %}{% endcapture %}{{ f | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
  "books": [{% assign sep = "" %}{% for shelf in site.data.books %}{% for b in shelf.books %}{{ sep }}{{ b.title | append: " (" | append: shelf.shelf | append: ")" | jsonify }}{% assign sep = ", " %}{% endfor %}{% endfor %}],
  "planet": {{ site.data.bar.bartender | jsonify }}
}
