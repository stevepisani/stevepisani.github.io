{
  "name": "stevenpisani",
  "private": true,
  "type": "module",
  "description": "The site's JavaScript and asset tools, versions pinned here and nowhere else. `npm run build` bundles and minifies the site's scripts into assets/js/dist/ (not committed) before Jekyll builds; `npm run models` rebuilds assets/models/props.glb.",
  "scripts": {
    "build": "node tools/build-js.mjs",
    "watch": "node tools/build-js.mjs --watch",
    "models": "node tools/build-models.mjs",
    "test": "node tools/wardrobe-test.mjs && node tools/smoke.mjs",
    "check": "node tools/check-site.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@imgly/background-removal": "1.7.0",
    "@supabase/supabase-js": "2.117.2",
    "n8ao": "2.0.1",
    "onnxruntime-web": "1.21.0",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "esbuild": "0.28.2",
    "meshoptimizer": "^1.0.1",
    "playwright": "1.56.1",
    "yaml": "2.9.1"
  }
}
